{
  "name": "eda-logistics",
  "version": "1.0.0",
  "description": "",
  "main": "agent.ts",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local build/server/src/index.js",
    "start:worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local build/server/src/worker.js",
    "dev:server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/src/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "worker": "node --env-file-if-exists=.env --import tsx server/src/worker.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eediallo/eda-logistics.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/eediallo/eda-logistics/issues"
  },
  "homepage": "https://github.com/eediallo/eda-logistics#readme",
  "dependencies": {
    "@google/adk": "^2.4.0",
    "@supabase/supabase-js": "^2.57.0",
    "fastify": "^5.6.0",
    "kafkajs": "^2.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@google/adk-devtools": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
